rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? userDoc().data.role : 'guest'; }
    function isAdmin() { return role() == 'admin'; }
    function canManage() { return role() in ['admin', 'moderator']; }

    match /items/{itemId} {
      allow read: if true;
      allow create: if canManage()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string && request.resource.data.description.size() <= 1500
        && request.resource.data.category is string && request.resource.data.category.size() <= 50
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.incentive is number && request.resource.data.incentive >= 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if canManage()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string && request.resource.data.description.size() <= 1500
        && request.resource.data.category is string && request.resource.data.category.size() <= 50
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.incentive is number && request.resource.data.incentive >= 0
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if canManage();
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.email == request.auth.token.email;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if (
        // Admin may change a member's role or name, but not identity fields.
        isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'name'])
        && request.resource.data.role in ['member', 'moderator', 'admin']
      ) || (
        // A user may finish their own profile setup without changing role or identity.
        // This also avoids a registration/onAuthStateChanged race during first sign-in.
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'createdAt'])
      );
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    match /shares/{shareId} {
      // New referral codes are the document IDs, making collisions impossible.
      // Legacy share documents remain readable and manageable under the rules below.
      allow create: if signedIn()
        && shareId.matches('ML-[A-F0-9]{10}')
        && request.resource.data.code == shareId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 100
        && request.resource.data.ownerName == userDoc().data.name
        && request.resource.data.itemId is string
        && exists(/databases/$(database)/documents/items/$(request.resource.data.itemId))
        && request.resource.data.itemName == get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.name
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || canManage());
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if canManage() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if canManage()
        && request.resource.data.itemId is string
        && exists(/databases/$(database)/documents/items/$(request.resource.data.itemId))
        && request.resource.data.itemName == get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.name
        && request.resource.data.buyerRef is string
        && request.resource.data.buyerRef.size() > 0
        && request.resource.data.buyerRef.size() <= 100
        && request.resource.data.amount is number && request.resource.data.amount >= 0
        && request.resource.data.incentive is number && request.resource.data.incentive >= 0
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 30
        && request.resource.data.submittedCode is string
        && request.resource.data.submittedCode.size() <= 30
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerName is string
        && (request.resource.data.ownerUid == ''
          ? request.resource.data.ownerName == '' && request.resource.data.code == ''
          : exists(/databases/$(database)/documents/users/$(request.resource.data.ownerUid))
            && request.resource.data.code.size() >= 6)
        && request.resource.data.status == 'pending'
        && request.resource.data.verifiedBy == ''
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if canManage()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'verifiedBy'])
        && request.resource.data.updatedAt is timestamp
        && (
          (resource.data.status == 'pending'
            && request.resource.data.status == 'verified'
            && request.resource.data.verifiedBy == request.auth.uid)
          || (resource.data.status == 'verified'
            && request.resource.data.status == 'paid'
            && request.resource.data.verifiedBy == request.auth.uid)
          || (resource.data.status in ['pending', 'verified']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.verifiedBy == resource.data.verifiedBy)
        );
      allow delete: if isAdmin();
    }
  }
}