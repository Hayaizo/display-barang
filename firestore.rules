rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() { return signedIn() && userDoc().data.role == 'admin'; }
    function canEditItems() {
      return signedIn() && userDoc().data.role in ['admin', 'editor'];
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'viewer'
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'name']);
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    match /items/{itemId} {
      allow read: if signedIn();
      allow create: if canEditItems()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1500
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 50
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if canEditItems()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1500
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 50
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if canEditItems();
    }
  }
}